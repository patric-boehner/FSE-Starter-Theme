{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cf/content-slot",
  "title": "Content Slot",
  "description": "Renders whichever Content Area currently wins this slot.",
  "icon": "layout",
  "category": "theme",
  "keywords": [
    "dynamic",
    "slot",
    "content area",
    "cta"
  ],
  "textdomain": "core-functionality",
  "attributes": {
    "slot": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": false,
    "anchor": true,
    "customClassName": true,
    "reusable": false
  },
  "editorScript": "file:./edit.js",
  "render": "file:./render.php"
}
